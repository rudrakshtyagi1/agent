# ===========================================================
# AgentGuard — Environment Variable Reference
# Copy this file to .env and fill in real values.
# Never commit .env to source control.
# ===========================================================

# Application
APP_NAME=AgentGuard
APP_ENV=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
# Local dev  : sqlite+aiosqlite:///./agentguard_dev.db
# Production : postgresql+asyncpg://user:password@host:5432/agentguard
DATABASE_URL=sqlite+aiosqlite:///./agentguard_dev.db

# Redis (Phase 2+)
REDIS_URL=redis://localhost:6379/0

# Qdrant (Phase 3+ RAG)
QDRANT_URL=http://localhost:6333

# Ollama (Phase 2+ LLM evaluation)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Logging
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Phase 7 monitoring: JSON object maps tenant names to UNIQUE bearer keys.
# Required for staging/production; each key needs >=32 characters. Generate securely.
# MONITOR_KEYS={"team-a":"<random-key-of-at-least-32-characters>"}
MONITOR_CAPTURE_PAYLOADS=false
MONITOR_QUEUE_CAPACITY=1000
MONITOR_SAMPLE_RATE=1.0
MONITOR_RETENTION_DAYS=7
MONITOR_POLL_SECONDS=1
MONITOR_WINDOW=50
MONITOR_MIN_SAMPLES=5
MONITOR_FAILURE_RATE=0.2
MONITOR_LATENCY_MS=5000
# Frontend build setting (set in frontend/.env or build environment):
# VITE_MONITOR_ONLY=true
